{
  "name": "serverest-cypress-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E e de API do ServeRest com Cypress",
  "scripts": {
    "cy:open": "node scripts/cypress.js open",
    "test": "node scripts/cypress.js run",
    "test:e2e": "node scripts/cypress.js run --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:api": "node scripts/cypress.js run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:report": "node scripts/cypress.js run",
    "report:github": "node scripts/github-summary.js",
    "validate:catalog": "node scripts/validate-test-catalog.js",
    "validate:style": "node scripts/validate-test-style.js",
    "audit:dependencies": "npm audit --audit-level=high",
    "lint": "eslint .",
    "quality:static": "npm run lint && npm run validate:catalog && npm run validate:style",
    "quality": "npm run quality:static && npm test",
    "quality:api": "npm run quality:static && npm run test:api",
    "quality:front": "npm run quality:static && npm run test:e2e",
    "verify": "node scripts/cypress.js verify"
  },
  "devDependencies": {
    "cypress": "^15.18.1",
    "eslint": "^9.39.5"
  },
  "engines": {
    "node": ">=20"
  }
}
